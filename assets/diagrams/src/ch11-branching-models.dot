digraph G { 

 rankdir=LR;
 subgraph cluster_trunk { label="Trunk-based development";
  {rank=same; t1; t2; t3; t4;}
  t1 [label="Trunk\n(integrate at\nleast daily)"]; t2 [label="Short-lived branch\n(hours)"];
  t3 [label="Reviewed merge\nto trunk"]; t4 [label="Release tag;\ndeploy from trunk"];
  t1 -> t2 -> t3 -> t4;
 }
 subgraph cluster_gh { label="GitHub Flow";
  {rank=same; h1; h2; h3; h4;}
  h1 [label="main\n(always deployable)"]; h2 [label="Feature branch\n(days)"];
  h3 [label="Review and\nrequired checks"]; h4 [label="Merge to main;\ndeploy from main"];
  h1 -> h2 -> h3 -> h4;
 }
 subgraph cluster_gf { label="Gitflow";
  {rank=same; f1; f2; f3; f4; f5;}
  f1 [label="main\n(released versions)"]; f2 [label="develop\n(integration)"];
  f4 [label="Feature and\nhotfix branches"]; f3 [label="Release branch\n(stabilization)"];
  f5 [label="Release and\npatch versions"];
  f1 -> f2 -> f4 -> f3 -> f5;
 }
 t1 -> h1 [style=invis]; h1 -> f1 [style=invis];
}
