digraph G { 
 
  rankdir=LR;
 root [label="Quality attribute\nrequirement\n(section 1.2)"];
 f1 [label="Operational continuity\navailability · reliability\nresilience · fault tolerance\nrecoverability (RTO / RPO)"];
 f2 [label="Capacity\nperformance · scalability"];
 f3 [label="Trust and compliance\nsecurity · privacy · auditability\n(privacy pulls against auditability)"];
