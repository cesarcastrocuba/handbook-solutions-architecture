digraph G { 

 rankdir=LR;
 c1 [label="Product scope,\ncapability,\npriority"];
 c2 [label="Engineering structure,\ninterfaces,\nownership"];
 c3 [label="Engineering runtime\nbehavior,\nfailure paths"];
 c4 [label="Operations deployment,\nrecovery,\ncapacity"];
 c5 [label="Security and privacy\ntrust boundaries, data\nmovement"];
 c6 [label="Architecture board\nrationale,\nconformance"];
 v1 [label="System context\n(people and external systems)"];
 v2 [label="Container\n(deployable units and stores)"];
 v3 [label="Sequence with failure paths\n(interactions over time)"];
 v4 [label="Deployment\n(nodes, zones, capacity)"];
 v5 [label="Data ownership and\ntrust-boundary map"];
 v6 [label="ADR set and\nquality scenarios"];
 c1->v1;
 c2->v2; c2->v5;
 c3->v3;
 c4->v4;
 c5->v5;
 c6->v6;
 subgraph cluster_note { label="Applies to every view";
  n [label="audience, owner, scope,\nrevision trigger, location;\nretire views that no longer\nmatch the deployed inventory"];
 }
 v1 -> n [style=invis];
}
