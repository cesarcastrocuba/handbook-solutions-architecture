digraph G {
 rankdir=TB;
 q1 [label="Multi-step process with\nwaits or compensation?", shape=diamond, style="filled"];
 q2 [label="Both sides owned and modern?", shape=diamond, style="filled"];
 q3 [label="Maintained connector exists?", shape=diamond, style="filled"];
 q4 [label="Within platform limits?", shape=diamond, style="filled"];
 wf [label="Workflow orchestrator;\nsteps call owners"];
 dc [label="Direct contract;\nsimple transport"];
 pl [label="Approved bus or iPaaS:\nmapping only"];
 ad [label="Dedicated adapter with\nanti-corruption layer"];
 ex [label="Exception and ADR (4.5)"];
 {rank=same; q1; wf;}
 {rank=same; q2; dc;}
 {rank=same; q3; ad;}
 {rank=same; q4; pl;}
 q1->wf [label="yes"]; q1->q2 [label=" no"];
 q2->dc [label="yes"]; q2->q3 [label=" no"];
 q3->q4 [label=" yes"]; q3->ad [label="no"];
 q4->pl [label="yes"]; q4->ex [label=" no"];
 ex->ad [constraint=false];
}
