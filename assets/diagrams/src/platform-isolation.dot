digraph G {
 rankdir=TB;
 subgraph cluster_foundation {
  label="Organization foundation: identity, network, policy, logging";
  subgraph cluster_shared {
   label="Shared production runtime: quotas, network policy\nand identities per namespace";
   n1 [label="Namespace:\nCheckout"];
   n2 [label="Namespace:\nOrder"];
   n3 [label="Namespace:\nInventory"];
  }
  np [label="Separate runtime for\nnon-production environments"];
  subgraph cluster_dedicated {
   label="Dedicated account";
   pay [label="Payments runtime:\ncard-data scope"];
  }
 }
}
