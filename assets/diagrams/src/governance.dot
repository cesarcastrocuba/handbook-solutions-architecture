digraph G { 

 rankdir=TB;
 p [label="Change proposal"];
 a [label="Automated guardrails (policy-as-code,\ncontract, dependency checks)"];
 c [label="Risk classification", shape=diamond, style="filled"];
 t1 [label="Tier 1 — Low risk\nTeam decides"];
 t2 [label="Tier 2 — Medium risk\nConsult platform and data owners"];
 t3 [label="Tier 3 — High / irreversible\nFocused review;\nrisk owner accepts"];
 r [label="Decision recorded (ADR, conditions,\nexceptions with expiry)"];
 v [label="Deploy and verify\nconditions with evidence"];
 p->a->c; c->t1; c->t2; c->t3; t1->r; t2->r; t3->r; r->v;
 v->a [label="incidents and\nfindings update\nguardrails", style=dashed, constraint=false];
}
