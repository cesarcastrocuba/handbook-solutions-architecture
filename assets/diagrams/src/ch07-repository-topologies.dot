digraph G { 

 rankdir=TB;
 subgraph cluster_poly { label="Polyrepo — independent pipelines,\nversioned packages"; labeljust="l"; labelloc="t";
  p1 [label="Same change spans\ntwo repositories"];
  p2 [label="Two review cycles;\nevery consumer upgrades\nand releases"];
  p1->p2;
 }
 subgraph cluster_hybrid { label="Hybrid — repository per domain,\npackages published"; labeljust="l"; labelloc="t";
  h1 [label="Same change stays\ninside the domain\nrepository"];
  h2 [label="Two pull requests;\nthe package is published\nand pinned by version"];
  h1->h2;
 }
 subgraph cluster_mono { label="Monorepo — atomic change,\none version policy"; labeljust="l"; labelloc="t";
  m1 [label="Change touches a\nservice and a shared\npackage"];
  m2 [label="One pull request;\nowners of both review;\naffected-only build"];
  m1->m2;
 }
 reg [label="Internal package registry:\npinned versions, deprecation\nwindow per major version"];
 h2->reg [label="publishes", style=dashed];
 p2->reg [label="publishes"];
}
