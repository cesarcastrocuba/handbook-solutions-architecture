digraph G { 

 rankdir=TB;
 start [label="Integration needed"];
 q1 [label="Must the caller wait for\nthe answer?", shape=diamond, style="filled"];
 q2 [label="Is buffering or temporal\ndecoupling worth the lag\nand reconciliation?", shape=diamond, style="filled"];
 sync [label="Request and response\ndeadline, bounded retries,\ncircuit breaker"];
 simple [label="Direct call\nkeep it simple"];
 async [label="Asynchronous message\nqueue or log; consumer\nowns recovery"];
 contract [class="focal", label="Every choice still needs a contract:\nversioning, authentication, failure\nsemantics, consumer migration"];
 start->q1;
 q1->sync [label=" yes"];
 q1->q2 [label=" no"];
 q2->async [label=" yes"];
 q2->simple [label=" no"];
 sync->contract; async->contract; simple->contract;
 {rank=same; sync; q2;} {rank=same; async; simple;}
}
