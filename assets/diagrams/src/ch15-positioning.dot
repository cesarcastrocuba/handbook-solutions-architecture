digraph G { 

 rankdir=TB;
 ent [label="Enterprise direction —\nportfolio and\ntransformation TOGAF ADM ·\nArchiMate · Zachman · SAFe"];
 sol [label="Solution description — one\nsystem, stakeholder\nconcerns ISO/IEC/IEEE\n42010 · arc42 · C4"];
