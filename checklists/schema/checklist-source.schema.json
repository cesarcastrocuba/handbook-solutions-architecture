{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RC2 source checklist transcription (editorial enrichment deferred)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_sha256",
    "sources_sha256",
    "section",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0-RC2-source"
    },
    "authority_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sources_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "section": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "section",
          "group",
          "question",
          "source_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CHK-(CH[0-9]{2}|APC)-[0-9]{2}$"
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "pattern": "^RC2-B[0-9]{4}$"
          }
        }
      }
    }
  }
}
