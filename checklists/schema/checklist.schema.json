{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cesarcastrocuba/solutions-architecture-handbook/checklists/schema/checklist.schema.json",
  "title": "Solutions Architecture Handbook Checklist Schema",
  "description": "Canonical schema for chapter architecture review checklists (Master Prompt Section 4.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chapter",
    "chapter_title",
    "checklist_title",
    "source_ref",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.1.0"
    },
    "chapter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "chapter_title": {
      "type": "string",
      "minLength": 3
    },
    "checklist_title": {
      "type": "string",
      "minLength": 3
    },
    "source_ref": {
      "type": "string",
      "minLength": 5
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "chapter",
          "section",
          "domain",
          "question",
          "verification_method",
          "evidence_expected",
          "severity_if_missing",
          "mandatory_or_contextual",
          "tags",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CHK-CH[0-9]{2}-[0-9]{2}$"
          },
          "chapter": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "section": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)*$"
          },
          "domain": {
            "type": "string",
            "minLength": 3
          },
          "question": {
            "type": "string",
            "minLength": 10
          },
          "verification_method": {
            "type": "string",
            "minLength": 5
          },
          "evidence_expected": {
            "type": "string",
            "minLength": 5
          },
          "severity_if_missing": {
            "type": "string",
            "enum": [
              "Critical",
              "High",
              "Medium",
              "Low"
            ]
          },
          "mandatory_or_contextual": {
            "type": "string",
            "enum": [
              "Mandatory",
              "Contextual"
            ]
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "version": {
            "type": "string",
            "enum": [
              "2.0-RC2",
              "2.1"
            ]
          }
        }
      }
    }
  }
}
