{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cesarcastrocuba/solutions-architecture-handbook/checklists/schema/review-checklist.schema.json",
  "title": "Canonical architecture review checklist (one domain)",
  "description": "Master Prompt §4.2. Stable SA-<DOMAIN>-NNN identifiers, independent of chapter numbering; never reuse a retired identifier.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "title", "manuscript", "items"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "domain": {"type": "string", "pattern": "^SA-[A-Z]{2,4}$"},
    "title": {"type": "string", "minLength": 3},
    "manuscript": {"type": "string", "pattern": "^(chapters|appendices)/[a-z0-9-]+\\.qmd$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "question", "rationale", "applicability", "expected_evidence", "section", "external_reference", "risk_relevance", "version", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^SA-[A-Z]{2,4}-[0-9]{3}$"},
          "title": {"type": "string"},
          "question": {"type": "string", "minLength": 10},
          "group": {"type": "string"},
          "rationale": {"type": "string"},
          "applicability": {"type": "string"},
          "expected_evidence": {"type": "string"},
          "section": {"type": "string", "pattern": "^([0-9]{1,2}|[A-G])(\\.[0-9]{1,2}){0,3}$"},
          "external_reference": {"type": "string"},
          "risk_relevance": {"enum": ["", "High", "Medium", "Low"]},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
          "status": {"enum": ["active", "retired"]}
        }
      }
    }
  }
}
